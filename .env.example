# MPLADS AI Monitor – Environment Configuration
# Copy this file to .env.local and fill in your actual backend URL
# .env.local is gitignored and takes precedence over this file

# FastAPI backend base URL (no trailing slash)
# Default: http://localhost:8000
# When backend is running: set to the actual host/port
VITE_API_BASE_URL=http://localhost:8000

# Optional: override the app title shown in browser tab
# VITE_APP_TITLE=MPLADS AI Monitor
